  const handleBulkUploadAccounts = (rawText: string) => {
    const lines = rawText
      .split(/\r?\n/)
      .map((l) => l.trim())
      .filter((l) => l && !l.toLowerCase().startsWith('name,'));
    if (lines.length === 0) {
      showToast('No valid user rows found to upload.', 'error');
      return;
    }
    let count = 0;
    lines.forEach((line) => {
      const parts = line.split(',').map((p) => p.trim());
      if (parts.length >= 2) {
        const [uName, uPass, rawRole, rawClass] = parts;
        const normRole = (rawRole || 'student').toLowerCase();
        const roleMap: Record<string, UserRole> = {
          super_admin: 'super_admin',
          admin: 'super_admin',
          principal: 'principal',
          teacher: 'teacher',
          faculty: 'teacher',
          student: 'student',
          parent: 'parent',
          accountant: 'accountant',
          finance: 'accountant'
        };
        const resolvedRole: UserRole = roleMap[normRole] || 'student';
        const resolvedClass = rawClass || '10-A';
        if (provisionUserAccount(uName, uPass, resolvedRole, resolvedClass)) {
          count++;
        }
      }
    });
    showToast(`Uploaded and activated ${count} user login account(s)! They can now log in directly.`, 'success');
  };

