    if (currentUser.role === 'parent') return selectedChildId;
    return 'STU-1001';
  }, [currentUser, selectedChildId]);

  // Visible students based on strict RBAC rules
  const visibleStudents = useMemo(() => {
    if (!currentUser) return [];
    let list = students;
    if (currentUser.role === 'teacher' && currentUser.assignedClasses) {
      list = students.filter((s) => currentUser.assignedClasses!.includes(s.classSection));
    } else if (currentUser.role === 'student') {
      list = students.filter((s) => s.id === currentUser.studentId);
    } else if (currentUser.role === 'parent' && currentUser.linkedStudentIds) {
      list = students.filter((s) => currentUser.linkedStudentIds!.includes(s.id));
    }
    if (sisClassFilter !== 'ALL') {
      list = list.filter((s) => s.classSection === sisClassFilter);
    }
    if (sisSearch.trim()) {
      const q = sisSearch.toLowerCase();
      list = list.filter(
        (s) =>
          s.fullName.toLowerCase().includes(q) ||
          s.admissionNo.toLowerCase().includes(q) ||
          s.id.toLowerCase().includes(q) ||
          s.guardianName.toLowerCase().includes(q)
      );
    }
    return list;
  }, [students, currentUser, sisClassFilter, sisSearch]);

  // Calculate attendance percentage per student
  const studentAttendanceStats = useMemo(() => {
    const map: Record<string, { present: number; total: number; percent: number }> = {};
    students.forEach((s) => {
      const entries = attendance.filter((a) => a.studentId === s.id);
      const total = entries.length || 1;
      const present = entries.filter((a) => a.status === 'Present' || a.status === 'Late').length;
      map[s.id] = { present, total: entries.length, percent: entries.length ? Math.round((present / total) * 100) : 100 };
    });
    return map;
  }, [students, attendance]);

  // Overall School KPI Metrics
  const kpiMetrics = useMemo(() => {
    const totalStudents = students.filter((s) => s.enrollmentStatus === 'Active').length;
    const totalTeachers = staffList.length;
    const presentCount = attendance.filter((a) => a.status === 'Present' || a.status === 'Late').length;
    const overallAttendancePercent = attendance.length ? Math.round((presentCount / attendance.length) * 100) : 94;

    const totalBilled = invoices.reduce((acc, inv) => acc + (inv.tuitionFee + inv.transportFee + inv.examAndLabFee + inv.annualCharges - inv.discountAmount), 0);
    const totalCollected = invoices.reduce((acc, inv) => acc + inv.paidAmount, 0);
    const pendingFees = Math.max(0, totalBilled - totalCollected);

    return {
      totalStudents,
      totalTeachers,
      totalClasses: ALL_CLASSES.length,
      overallAttendancePercent,
      totalBilled,
      totalCollected,
      pendingFees
    };
  }, [students, staffList, attendance, invoices]);

  // Timetable Conflict Detector
  const timetableConflicts = useMemo(() => {
    const conflicts: string[] = [];
    for (let i = 0; i < timetable.length; i++) {
      for (let j = i + 1; j < timetable.length; j++) {
        const a = timetable[i];
        const b = timetable[j];
        if (a.day === b.day && a.period === b.period) {
          if (a.teacherName === b.teacherName && a.classSection !== b.classSection) {
            conflicts.push(
              `Teacher Conflict: ${a.teacherName} is double-booked on ${a.day} Period ${a.period} in both ${a.classSection} and ${b.classSection}.`
            );
          }
          if (a.room === b.room && a.classSection !== b.classSection) {
            conflicts.push(
              `Room Conflict: ${a.room} is allocated to both ${a.classSection} and ${b.classSection} on ${a.day} Period ${a.period}.`
            );
          }
        }
      }
    }
    return conflicts;
  }, [timetable]);

