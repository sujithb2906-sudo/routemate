      uid: `usr-${Date.now()}-${Math.floor(Math.random() * 1000)}`,
      name: cleanName,
      email,
      passwordHash: cleanPassword,
      role,
      status: 'active',
      approved: true,
      emailVerified: true,
      phone: rawPhone || '+91 98450 00000',
      department: ROLE_META[role].label,
