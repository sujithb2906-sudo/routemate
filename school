                      `----------------------------------------`,
                      ...reportCardModalStudent.exam.subjects.map(
                        (s) => `${s}: ${reportCardModalStudent.mark.scores[s] || 0}/100 (${computeCBSEGrade(reportCardModalStudent.mark.scores[s] || 0).grade})`
                      ),
                      `----------------------------------------`,
                      `Remarks: ${reportCardModalStudent.mark.remarks}`
                    ].join('\n');
                    triggerFileDownload(`ReportCard_${reportCardModalStudent.student.admissionNo}.txt`, lines, 'text/plain');
                    showToast('Downloaded official Report Card.', 'success');
                  }}
                  className="px-4 py-2 rounded-xl bg-blue-600 text-white font-semibold flex items-center gap-1.5"
                >
                  <Download className="w-4 h-4" />
                  <span>Download Report Card</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Modal 4: Record Payment Modal */}
      {paymentModalInvoice && (
        <div className="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
          <div className={`max-w-md w-full rounded-2xl p-6 border shadow-2xl space-y-4 ${darkMode ? 'bg-slate-900 border-slate-800' : 'bg-white border-slate-200'}`}>
            <div className="flex items-center justify-between">
              <h3 className="font-bold text-base">Record Fee Payment & Issue Receipt</h3>
              <button type="button" onClick={() => setPaymentModalInvoice(null)}>
                <X className="w-4 h-4" />
              </button>
            </div>
            <form onSubmit={handleRecordPayment} className="space-y-3 text-xs">
              <div>
                Student: <strong>{paymentModalInvoice.studentName}</strong> ({paymentModalInvoice.invoiceNo})
              </div>
              <div>
                <label className="block font-semibold mb-1">Amount Paid (INR)</label>
                <input
                  type="number"
                  required
                  min={1}
                  value={paymentAmountInput}
                  onChange={(e) => setPaymentAmountInput(Number(e.target.value))}
                  className="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-transparent font-bold"
                />
              </div>
              <div>
                <label className="block font-semibold mb-1">Payment Mode</label>
                <select
                  value={paymentModeInput}
                  onChange={(e) => setPaymentModeInput(e.target.value as typeof paymentModeInput)}
                  className="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800"
                >
                  <option value="NEFT/IMPS">NEFT / IMPS Bank Transfer</option>
                  <option value="UPI / QR">Verified Institutional UPI</option>
                  <option value="Cash Counter">School Cash Counter</option>
                  <option value="Cheque">Demand Draft / Cheque</option>
                </select>
              </div>
              <div>
                <label className="block font-semibold mb-1">Transaction Reference Number</label>
                <input
                  type="text"
                  required
                  value={paymentRefInput}
                  onChange={(e) => setPaymentRefInput(e.target.value)}
                  className="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-transparent"
                />
              </div>
              <div className="flex justify-end gap-2 pt-2">
                <button type="button" onClick={() => setPaymentModalInvoice(null)} className="px-4 py-2 rounded-xl border">
                  Cancel
                </button>
                <button type="submit" className="px-4 py-2 rounded-xl bg-emerald-600 text-white font-semibold">
                  Save & Generate Receipt
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* Modal 5: Official Fee Receipt Viewer */}
      {receiptModalItem && (
        <div className="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
          <div className={`max-w-md w-full rounded-2xl p-6 border shadow-2xl space-y-4 ${darkMode ? 'bg-slate-900 border-slate-800' : 'bg-white border-slate-200'}`}>
            <div className="flex items-center justify-between border-b pb-3 border-slate-200 dark:border-slate-800">
              <div>
                <h3 className="font-bold text-base">Official Fee Payment Receipt</h3>
                <p className="text-xs font-mono text-blue-600">{receiptModalItem.receiptNo}</p>
              </div>
              <button type="button" onClick={() => setReceiptModalItem(null)}>
                <X className="w-4 h-4" />
              </button>
            </div>
            <div className="text-xs space-y-2">
              <div className="flex justify-between"><span>Institution:</span><strong>{schoolConfig.schoolName}</strong></div>
              <div className="flex justify-between"><span>Student Name:</span><strong>{receiptModalItem.studentName}</strong></div>
              <div className="flex justify-between"><span>Class & Section:</span><strong>{receiptModalItem.classSection}</strong></div>
              <div className="flex justify-between"><span>Payment Mode:</span><strong>{receiptModalItem.mode}</strong></div>
              <div className="flex justify-between"><span>Bank Reference:</span><strong>{receiptModalItem.referenceNo}</strong></div>
              <div className="flex justify-between"><span>Date:</span><strong>{receiptModalItem.paidDate}</strong></div>
              <div className="flex justify-between"><span>Cashier / Officer:</span><strong>{receiptModalItem.recordedBy}</strong></div>
              <div className="flex justify-between pt-2 border-t text-sm font-bold text-emerald-600">
                <span>Total Amount Received:</span>
                <span>₹{receiptModalItem.amount.toLocaleString('en-IN')}</span>
              </div>
            </div>
            <button
              type="button"
              onClick={() => {
                triggerFileDownload(
                  `FeeReceipt_${receiptModalItem.receiptNo}.txt`,
                  `OFFICIAL FEE RECEIPT — ${schoolConfig.schoolName}\nReceipt No: ${receiptModalItem.receiptNo}\nStudent: ${receiptModalItem.studentName} (${receiptModalItem.classSection})\nAmount Paid: INR ${receiptModalItem.amount}\nMode: ${receiptModalItem.mode} (Ref: ${receiptModalItem.referenceNo})\nDate: ${receiptModalItem.paidDate}\nVerified By: ${receiptModalItem.recordedBy}`,
                  'text/plain'
                );
                showToast(`Downloaded Receipt ${receiptModalItem.receiptNo}`, 'success');
              }}
              className="w-full py-2 rounded-xl bg-blue-600 text-white text-xs font-semibold"
            >
              Download Official Receipt
            </button>
          </div>
        </div>
      )}

      {/* Modal 6: Schedule New Examination */}
      {showNewExamModal && (
        <div className="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
          <div className={`max-w-md w-full rounded-2xl p-6 border shadow-2xl space-y-4 ${darkMode ? 'bg-slate-900 border-slate-800' : 'bg-white border-slate-200'}`}>
            <div className="flex items-center justify-between">
              <h3 className="font-bold text-base">Schedule New Academic Examination</h3>
              <button type="button" onClick={() => setShowNewExamModal(false)}>
                <X className="w-4 h-4" />
              </button>
            </div>
            <div className="space-y-3 text-xs">
              <div>
                <label className="block font-semibold mb-1">Examination Title</label>
                <input
                  type="text"
                  placeholder="e.g., Term 2 Pre-Board Assessment (Dec 2026)"
                  value={newExamForm.name}
                  onChange={(e) => setNewExamForm({ ...newExamForm, name: e.target.value })}
                  className="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-transparent"
                />
              </div>
              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block font-semibold mb-1">Class Section</label>
                  <select
                    value={newExamForm.classSection}
                    onChange={(e) => setNewExamForm({ ...newExamForm, classSection: e.target.value })}
                    className="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800"
                  >
                    {ALL_CLASSES.map((c) => (
                      <option key={c} value={c}>{c}</option>
                    ))}
                  </select>
                </div>
                <div>
                  <label className="block font-semibold mb-1">Start Date</label>
                  <input
                    type="date"
                    value={newExamForm.startDate}
                    onChange={(e) => setNewExamForm({ ...newExamForm, startDate: e.target.value })}
                    className="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-transparent"
                  />
                </div>
              </div>
              <button
                type="button"
                onClick={() => {
                  if (!newExamForm.name.trim()) {
                    showToast('Please enter an examination name.', 'error');
                    return;
                  }
                  const ex: Examination = {
                    id: `EXM-${Date.now()}`,
                    name: newExamForm.name,
                    term: newExamForm.term,
                    academicYear,
                    classSection: newExamForm.classSection,
                    startDate: newExamForm.startDate,
                    maxMarksPerSubject: 100,
                    subjects: ['Mathematics', 'Physics', 'Chemistry', 'English', 'Computer Science'],
                    published: false
                  };
                  setExams((prev) => [...prev, ex]);
                  setSelectedExamId(ex.id);
                  setShowNewExamModal(false);
                  showToast(`Scheduled examination "${ex.name}"`, 'success');
                }}
                className="w-full py-2 rounded-xl bg-blue-600 text-white font-semibold"
              >
                Create Examination Schedule
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Modal 7: User Profile & Password Change */}
      {showProfileModal && (
        <div className="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
          <div className={`max-w-md w-full rounded-2xl p-6 border shadow-2xl space-y-4 ${darkMode ? 'bg-slate-900 border-slate-800' : 'bg-white border-slate-200'}`}>
            <div className="flex items-center justify-between">
              <h3 className="font-bold text-base">Account Profile & Security</h3>
              <button type="button" onClick={() => setShowProfileModal(false)}>
                <X className="w-4 h-4" />
              </button>
            </div>
            <div className="text-xs space-y-2">
              <div>Name: <strong>{currentUser.name}</strong></div>
              <div>Email: <strong>{currentUser.email}</strong></div>
              <div>Role: <strong>{ROLE_META[currentUser.role].label}</strong></div>
              <div>Email Verification: <strong className="text-emerald-600">Verified</strong></div>
            </div>
            <div className="pt-3 border-t border-slate-200 dark:border-slate-800 space-y-2 text-xs">
              <label className="block font-semibold">Update Account Password</label>
              <input
                type="password"
                placeholder="Enter new password (min 6 chars)"
                value={newPasswordInput}
                onChange={(e) => setNewPasswordInput(e.target.value)}
                className="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-transparent"
              />
              <button
                type="button"
                onClick={() => {
                  if (newPasswordInput.length < 6) {
                    showToast('Password must be at least 6 characters.', 'error');
                    return;
                  }
                  setUsers((prev) =>
                    prev.map((u) => (u.uid === currentUser.uid ? { ...u, passwordHash: newPasswordInput } : u))
                  );
                  setNewPasswordInput('');
                  setShowProfileModal(false);
                  showToast('Account password updated securely.', 'success');
                }}
                className="w-full py-2 rounded-xl bg-blue-600 text-white font-semibold"
              >
                Update Password
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Modal 8: Firebase Architecture & Security Rules Inspector */}
      {showFirebaseModal && (
        <div className="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
          <div className={`max-w-2xl w-full rounded-2xl p-6 border shadow-2xl space-y-4 max-h-[85vh] overflow-y-auto ${darkMode ? 'bg-slate-900 border-slate-800' : 'bg-white border-slate-200'}`}>
            <div className="flex items-center justify-between border-b pb-3 border-slate-200 dark:border-slate-800">
              <div>
                <h3 className="font-bold text-base">Firebase Cloud Architecture & 27-Collection Schema</h3>
                <p className="text-xs text-slate-500">
                  Full backend code (`firestore.rules`, `storage.rules`, `functions/src/index.ts`, `firebase.ts`) is bundled in the project archive.
                </p>
              </div>
              <button type="button" onClick={() => setShowFirebaseModal(false)}>
                <X className="w-5 h-5" />
              </button>
            </div>
            <div className="text-xs space-y-3">
              <div className="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800 space-y-1">
                <div className="font-bold text-blue-600">27 Firestore Collections Configured</div>
                <p className="text-slate-600 dark:text-slate-300 font-mono text-[11px]">
                  schools, users, roles, students, guardians, staff, classes, sections, subjects, academicYears, attendance, examinations, marks, grades, assignments, submissions, feeStructures, invoices, payments, timetables, announcements, libraryRecords, transport, leaveApplications, documents, notifications, auditLogs
                </p>
              </div>
              <div className="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800 space-y-1">
                <div className="font-bold text-emerald-600">Key Security & Privacy Controls (DPDP Act 2023)</div>
                <p className="text-slate-600 dark:text-slate-300">
                  • Public registration strictly blocks `super_admin` and `principal` role escalation (`approved == false` enforced in `firestore.rules`).<br />
                  • Teachers can only read/write students, attendance, and marks for `resource.data.classSection in getUserData().assignedClasses`.<br />
                  • Students and Parents can only read `marks` when `resource.data.published == true` and only for their own `studentId` or `linkedStudentIds`.<br />
                  • Financial payments and audit logs are append-only (`allow delete: if false`).
                </p>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Notifications Drawer */}
      {showNotificationsDrawer && (
        <div className="fixed top-16 right-4 z-50 w-80 rounded-2xl p-4 border shadow-2xl space-y-3 bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-800 text-xs">
          <div className="flex items-center justify-between font-bold">
            <span>In-App Notifications (4)</span>
            <button type="button" onClick={() => setShowNotificationsDrawer(false)}>
              <X className="w-4 h-4" />
            </button>
          </div>
          <div className="divide-y divide-slate-200 dark:divide-slate-800 space-y-2">
            <div className="pt-2">
              <div className="font-semibold text-blue-600">Term 1 Results Published</div>
              <p className="text-slate-500">Mid-Semester Assessment report cards are live for Class 10-A.</p>
            </div>
            <div className="pt-2">
              <div className="font-semibold text-amber-600">Homework Deadline: Nov 24</div>
              <p className="text-slate-500">Quadratic Equations Problem Set 4B due for Class 10-A.</p>
            </div>
            <div className="pt-2">
              <div className="font-semibold text-emerald-600">Parent-Teacher Meeting</div>
              <p className="text-slate-500">Scheduled on Nov 28, 2026 (09:00 AM – 01:00 PM).</p>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
