    const lastName = LAST_NAMES[(i + clsIdx * 2) % LAST_NAMES.length];
    const fullName = `${firstName} ${lastName} (${cls})`;
    const usernameSlug = `${firstName.toLowerCase()}${gradeNum}a${rollNo}`;
    const passwordPlain = `stu${codeNum}`;
    const guardianName = `${GUARDIAN_FIRST_NAMES[i]} ${lastName}`;
    const phone = `+91 9845${gradeNum % 10} ${String(10000 + i * 111 + clsIdx * 37).slice(0, 5)}`;

    GENERATED_STUDENTS.push({
      id: studentId,
      admissionNo,
      rollNo,
      fullName,
      dob: `${2020 - gradeNum}-0${(i % 9) + 1}-1${i % 9}`,
      gender: i % 2 === 0 ? 'Male' : 'Female',
      classSection: cls,
      academicYear: '2026-27',
      enrollmentStatus: 'Active',
      guardianName,
      guardianRelation: i % 2 === 0 ? 'Father' : 'Mother',
      guardianPhone: phone,
      guardianEmail: `${usernameSlug}.parent@edusphere.edu`,
      emergencyContact: phone,
      address: `${10 + i * 4}, Indiranagar Stage ${((clsIdx + i) % 3) + 1}, Bengaluru`,
      previousSchool: gradeNum === 1 ? 'Indraprastha Kindergarten' : 'Indraprastha Primary Wing',
      bloodGroup: ['O+', 'A+', 'B+', 'AB+'][i % 4],
      dpdpConsentVerified: true,
      transportRouteId: `TR-0${(i % 3) + 1}`,
      documents: [
        { name: `Birth_Certificate_${studentId}.pdf`, type: 'Identity', verified: true, uploadedAt: '2026-04-02' },
        { name: `DPDP_Consent_${studentId}.pdf`, type: 'Privacy Consent', verified: true, uploadedAt: '2026-04-05' }
      ]
    });

    GENERATED_STUDENT_USERS.push({
      uid: `usr-stu-${codeNum}`,
      name: fullName,
      email: `${usernameSlug}@edusphere.edu`,
      passwordHash: passwordPlain,
      role: 'student',
      status: 'active',
      approved: true,
      emailVerified: true,
      phone,
      studentId,
      lastLogin: 'Active Student Account'
    });

    GENERATED_ATTENDANCE.push({
      id: `att-18-${studentId}`,
      date: '2026-11-18',
      classSection: cls,
      subject: 'Daily Homeroom',
      studentId,
      status: i === 8 ? 'Absent' : i === 9 ? 'Late' : 'Present',
      markedBy: 'Prof. Ananya Deshmukh'
    });

    GENERATED_ATTENDANCE.push({
      id: `att-17-${studentId}`,
      date: '2026-11-17',
      classSection: cls,
      subject: 'Daily Homeroom',
      studentId,
      status: 'Present',
      markedBy: 'Prof. Ananya Deshmukh'
    });

    const scores: Record<string, number> = {};
    subjects.forEach((subj, sIdx) => {
      scores[subj] = Math.min(98, 68 + ((i * 5 + sIdx * 3 + clsIdx * 2) % 30));
    });
    GENERATED_MARKS.push({
      id: `MRK-${codeNum}`,
      examId,
      studentId,
      classSection: cls,
      scores,
      remarks: 'Consistent academic progress across Term 1 subjects.',
      updatedBy: 'Prof. Ananya Deshmukh',
      updatedAt: '2026-10-25'
    });

    if (i < 3) {
      GENERATED_INVOICES.push({
        id: `INV-${codeNum}`,
        invoiceNo: `IGA/2026-27/INV-${codeNum}`,
        studentId,
        studentName: fullName,
        classSection: cls,
        academicYear: '2026-27',
        term: 'Annual Composite Fee',
        tuitionFee: 48000 + gradeNum * 1500,
        transportFee: 18000,
        examAndLabFee: 6000,
        annualCharges: 8000,
        discountAmount: i === 0 ? 5000 : 0,
        discountReason: i === 0 ? 'Merit Scholarship' : undefined,
        paidAmount: i === 0 ? 75000 + gradeNum * 1500 : 45000,
        dueDate: '2026-11-30',
        status: i === 0 ? 'Paid' : 'Partial'
      });
    }
  }
});

