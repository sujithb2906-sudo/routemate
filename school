  const handleMarkAttendance = (studentId: string, status: AttendanceStatus) => {
    if (!['super_admin', 'principal', 'teacher'].includes(currentUser.role)) {
      showToast('Students and parents cannot modify official attendance records.', 'error');
      return;
    }
    setAttendance((prev) => {
      const existingIdx = prev.findIndex(
        (a) => a.studentId === studentId && a.date === attDateFilter && a.subject === attSubjectFilter
      );
      if (existingIdx >= 0) {
        const clone = [...prev];
        clone[existingIdx] = { ...clone[existingIdx], status, markedBy: currentUser.name };
        return clone;
      }
      return [
        ...prev,
        {
          id: `att-${Date.now()}-${studentId}`,
          date: attDateFilter,
          classSection: attClassFilter,
          subject: attSubjectFilter,
          studentId,
          status,
          markedBy: currentUser.name
        }
      ];
    });
    if (status === 'Absent' || status === 'Late') {
      queueParentEmail(
        studentId,
        'ATTENDANCE_ALERT',
        `[Indraprastha Global Academy] Attendance Alert: Marked ${status} on ${attDateFilter}`
      );
      showToast(`Marked ${studentId} as ${status} & queued real-time parent email alert.`, 'info');
    } else {
      showToast(`Marked ${studentId} as ${status} for ${attDateFilter}`, 'success');
    }
  };

